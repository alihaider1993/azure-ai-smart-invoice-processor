# Local development with `az login` (run_pipeline.py). For the Streamlit app,
# infra/setup_azure.sh writes .streamlit/secrets.toml instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
DOC_INTEL_ENDPOINT=
COSMOS_ENDPOINT=

# Service principal (Streamlit Community Cloud). Leave blank locally to use `az login`.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Shows the admin "delete all invoice data" control on the Dashboard when set
ADMIN_PASSWORD=
# Maximum invoices processed per rolling 24 hours (cost guard)
DAILY_INVOICE_LIMIT=40
